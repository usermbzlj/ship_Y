{
  "name": "far-horizon-ship-simulator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/start-development.mjs",
    "dev:deepseek": "node scripts/start-deepseek.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "build": "vinext build",
    "start": "node scripts/start-production.mjs",
    "logs:latest": "node scripts/show-latest-log.mjs",
    "test": "node scripts/run-tests.mjs --suite=fast",
    "test:unit": "node scripts/run-tests.mjs --suite=fast",
    "test:fast": "node scripts/run-tests.mjs --suite=fast",
    "test:heavy": "node scripts/run-tests.mjs --suite=heavy",
    "test:full": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run check:docs && npm run typecheck && npm run lint && npm run build && npm run test:fast",
    "check:release": "npm run check && npm run test:heavy"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
